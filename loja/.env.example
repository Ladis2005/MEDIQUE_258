# Copie este ficheiro para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Sem estes valores, a loja funciona em modo local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endereço público da loja, sem barra no fim (ex.: https://medique.co.mz).
# Usado nas pré-visualizações de partilha (WhatsApp, Facebook), no Google e no sitemap.xml.
VITE_SITE_URL=

# Pixel do Facebook (Meta). Vazio = sem pixel.
VITE_META_PIXEL_ID=

# Só para o modo local (sem Supabase): palavra-passe do painel /admin.
VITE_LOCAL_ADMIN_PASSWORD=medique
